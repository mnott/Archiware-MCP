# Copy to .env (gitignored) and edit; `archiware viewer_deploy` writes it for you. Values are placeholders.
# docker network the containers join (external, must exist) and their fixed addresses on it
DOCKER_NETWORK=dockernet
CATALOG_IP=192.0.2.30
CATALOG_DB_IP=192.0.2.31
# host paths: P5's config/index/backup (read-only), the pack root (read-only), the database files
P5_INDEX_DIR=/path/to/p5/config/index/backup
PACK_ROOT=/path/to/pack-root
DB_DATA_DIR=./data/db
# the web container runs as this user so it can read ./secrets (`id -u`, `id -g` of the install user)
CATALOG_UID=1000
CATALOG_GID=1000
TZ=UTC
